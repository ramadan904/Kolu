# Hermes API key. REQUIRED for live prices — Pyth began requiring
# authentication in August 2026. Without it, symbol resolution still succeeds
# but every price request returns 401, and the board falls back to labelled
# demo data.
# PYTH_API_KEY=

# Pyth Hermes endpoint.
# PYTH_HERMES_ENDPOINT=https://hermes.pyth.network

# Force the deterministic demo data instead of live prices: "pyth" | "fixture".
# Leave unset for live. The app falls back to fixtures automatically (and says
# so on screen) whenever the live source is unreachable.
# KOLU_PRICE_SOURCE=fixture

# Which demo scenario to render in fixture mode:
#   weekend_drift    — market shut, board has drifted off Friday's close
#   live_dislocation — market open, one name genuinely dislocated
#   calm             — everything inside the noise floor
#   degraded         — the equity reference has stalled mid-session
# KOLU_SCENARIO=weekend_drift
